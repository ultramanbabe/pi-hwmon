[Unit]
Description=Hardware monitor kiosk (cage + chromium)
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=pi
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
PAMName=login
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
ExecStartPre=/usr/bin/chvt 1
ExecStart=/usr/bin/cage -s -- /usr/local/bin/hwmon-kiosk.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
